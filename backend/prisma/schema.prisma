// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  currency  String   @default("RON") @db.Char(3)
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  participants    Participant[]
  expenses        Expense[]
  settlementPlans SettlementPlan[]

  @@index([ownerId])
  @@map("trips")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trips           Trip[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Participant {
  id     String @id @default(uuid()) @db.Uuid
  tripId String @map("trip_id") @db.Uuid
  name   String @db.VarChar(100)

  trip         Trip           @relation(fields: [tripId], references: [id])
  paidExpenses Expense[]      @relation("ExpensePayer")
  shares       ExpenseShare[]

  @@index([tripId])
  @@map("participants")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  payerId     String   @map("payer_id") @db.Uuid
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip   Trip           @relation(fields: [tripId], references: [id])
  payer  Participant    @relation("ExpensePayer", fields: [payerId], references: [id])
  shares ExpenseShare[]

  @@index([tripId, createdAt])
  @@index([payerId])
  @@map("expenses")
}

model ExpenseShare {
  id            String  @id @default(uuid()) @db.Uuid
  expenseId     String  @map("expense_id") @db.Uuid
  participantId String  @map("participant_id") @db.Uuid
  amount        Decimal @db.Decimal(10, 2)

  expense     Expense     @relation(fields: [expenseId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@unique([expenseId, participantId])
  @@index([participantId])
  @@map("expense_shares")
}

model SettlementPlan {
  id            String    @id @default(uuid()) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  revision      Int
  currency      String    @db.Char(3)
  transferCount Int       @map("transfer_count")
  isCurrent     Boolean   @default(true) @map("is_current")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(6)

  trip      Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  balances  SettlementBalance[]
  transfers SettlementTransfer[]

  @@unique([tripId, revision])
  @@index([tripId, isCurrent, createdAt])
  @@map("settlement_plans")
}

model SettlementBalance {
  id              String  @id @default(uuid()) @db.Uuid
  planId          String  @map("plan_id") @db.Uuid
  participantId   String  @map("participant_id") @db.Uuid
  participantName String  @map("participant_name") @db.VarChar(100)
  balance         Decimal @db.Decimal(10, 2)

  plan     SettlementPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  outgoing SettlementTransfer[] @relation("SettlementTransferFrom")
  incoming SettlementTransfer[] @relation("SettlementTransferTo")

  @@unique([planId, participantId])
  @@unique([planId, id])
  @@index([planId])
  @@map("settlement_balances")
}

model SettlementTransfer {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  sequence      Int
  fromBalanceId String    @map("from_balance_id") @db.Uuid
  toBalanceId   String    @map("to_balance_id") @db.Uuid
  amount        Decimal   @db.Decimal(10, 2)
  isPaid        Boolean   @default(false) @map("is_paid")
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)

  plan        SettlementPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  fromBalance SettlementBalance @relation("SettlementTransferFrom", fields: [planId, fromBalanceId], references: [planId, id], onDelete: Cascade)
  toBalance   SettlementBalance @relation("SettlementTransferTo", fields: [planId, toBalanceId], references: [planId, id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([planId])
  @@map("settlement_transfers")
}
