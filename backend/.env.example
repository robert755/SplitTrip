# Copy this file to .env and replace the placeholders with the values from Supabase.
# Used by the app at runtime via the transaction-mode pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used by Prisma CLI commands and migrations via the session-mode pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Generate a unique random value of at least 32 characters for your local .env.
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Exact browser origins allowed to call the API; separate multiple origins with commas.
FRONTEND_ORIGINS="http://localhost:3000"

# Cookie path for local direct API requests. Use /api/auth when requests go
# through the frontend's same-origin /api proxy in production.
REFRESH_TOKEN_COOKIE_PATH="/auth"

# Keep the API on a different port from the Next.js frontend.
PORT=3001
