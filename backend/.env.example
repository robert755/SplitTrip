# Copy this file to .env and replace the placeholders with the values from Supabase.
# Used by the app at runtime via the transaction-mode pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Used by Prisma CLI commands and migrations via the session-mode pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
